# Copy to .env (or merge) when running API/worker in Docker.
# Host GPU services must be reachable via host.docker.internal.

DATABASE_URL=postgresql://docuflow:docuflow@postgres:5432/docuflow
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=docuflow-digest

# Keep numeric ETA hidden while calibration observations accumulate.
ETA_ENABLED=true
ETA_SHADOW_MODE=true
ETA_PROFILE_MIN_SAMPLES=20
ETA_PUBLIC_PROFILE_KEYS=

# OCR vLLM on host (start.sh / serve_deepseek_ocr.sh)
VLLM_SERVER_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=123

# Pipeline LLM (llama.cpp docker on host :5011)
AI_PROVIDER=openai
AI_OPENAI_BASE_URL=http://host.docker.internal:5011/v1
AI_MODEL=qwen3.5-9b

API_PORT=8022
UPLOAD_DIR=/app/uploads

# Split workers: compose runs --role pipeline and --role extraction.
# MAX_CONCURRENT_PIPELINES=2
# EXTRACTION_MAX_CONCURRENT=1
# WORKER_GRACEFUL_SHUTDOWN_SECONDS=300
# REQUIRE_REGISTRATION_APPROVAL=true
# JWT_SECRET_KEY=change-me-in-production
# ADMIN_PASSWORD=change-me

