# Copy to .env (or merge) when running API/worker in Docker.
# Host GPU services must be reachable via host.docker.internal.

DATABASE_URL=postgresql://docuflow:docuflow@postgres:5432/docuflow
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=docuflow-digest

# OCR vLLM on host (start.sh / serve_deepseek_ocr.sh)
VLLM_SERVER_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=123

# Pipeline LLM (llama.cpp docker on host :5011)
AI_PROVIDER=openai
AI_OPENAI_BASE_URL=http://host.docker.internal:5011/v1
AI_MODEL=qwen3.5-9b

API_PORT=8022
UPLOAD_DIR=/app/uploads
