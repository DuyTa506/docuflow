[Unit]
Description=DocuFlow Temporal extraction worker (Docling + DeepSeek-OCR — holds GPU)
Documentation=file://@@DOCUFLOW_ROOT@@/CLAUDE.md
After=network-online.target docuflow-infra.service
Wants=docuflow-infra.service

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
WorkingDirectory=@@DOCUFLOW_ROOT@@
Environment=HOME=@@SERVICE_HOME@@
EnvironmentFile=-@@DOCUFLOW_ROOT@@/.env
Environment=TEMPORAL_HOST=localhost:7233
ExecStartPre=@@DOCUFLOW_ROOT@@/scripts/wait_for_port.sh localhost 7233 180
# Process duy nhất nạp Docling (layout, TableFormer, CodeFormula) lên GPU.
# Tách khỏi docuflow-temporal-worker để một lượt digest nhiều giờ không phải
# gánh ba model đó nằm không trên GPU — chính là thứ đã khiến vLLM OCR không
# đủ 9,41 GB để khởi động và docuflow-backend crash-loop 447 lần.
ExecStart=@@DOCUFLOW_ROOT@@/scripts/start_temporal_worker.sh --role extraction
Restart=always
RestartSec=15
TimeoutStartSec=300
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
