# DeepSeek OCR + PageIndex + DocuFlow Library Services

# ============================================
# vLLM Server (DeepSeek OCR)
# ============================================
VLLM_API_KEY=05062001
VLLM_SERVER_URL=https://<your-ngrok-url>.ngrok-free.app/v1
VLLM_MODEL=deepseek-ai/DeepSeek-OCR-2

# ============================================
# OpenAI API (for PageIndex & AI services)
# ============================================
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Database
# ============================================
# DATABASE_URL=sqlite:///document_store.db

# ============================================
# OCR Parameters (Optional)
# ============================================
# OCR_MAX_TOKENS=4096
# OCR_TEMPERATURE=0.0
# OCR_TARGET_DPI=200
# OCR_MAX_IMAGE_SIZE=2048

# ============================================
# PageIndex Settings (Optional)
# ============================================
# PAGEINDEX_LLM_PROVIDER=openai
# PAGEINDEX_MODEL=gpt-4o-2024-11-20
# PAGEINDEX_IF_THINNING=true
# PAGEINDEX_MIN_TOKEN_THRESHOLD=5000

# ============================================
# For Ollama (alternative to OpenAI)
# ============================================
# PAGEINDEX_LLM_PROVIDER=ollama
# PAGEINDEX_MODEL=llama2
# PAGEINDEX_OLLAMA_BASE_URL=http://localhost:11434
# PAGEINDEX_OLLAMA_TIMEOUT=300

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# AI Services (Translation, Summarization, etc.)
# ============================================
AI_PROVIDER=openai
AI_MODEL=gpt-4o-2024-11-20
# AI_OLLAMA_BASE_URL=http://localhost:11434

# Optional: override the OpenAI base URL to use any OpenAI-compatible endpoint.
# Leave unset (or empty) to use the default OpenAI API.
#
# --- Alibaba Cloud (DashScope) ---
# Singapore:       AI_OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# US (Virginia):   AI_OPENAI_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# China (Beijing): AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Germany (Frankfurt): AI_OPENAI_BASE_URL=https://{WorkspaceId}.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
#
# When using DashScope, also set:
#   AI_MODEL=qwen3-max        (or qwen3-plus, qwen-max, etc.)
#   OPENAI_API_KEY=sk-...     (your DashScope API key)
# AI_OPENAI_BASE_URL=

# ── AI Chunking & Output Language ─────────────────────────────
# Context window size of the pipeline LLM (tokens).  Used to
# derive the per-chunk token budget together with AI_CHUNK_RATIO.
# AI_MODEL_CONTEXT_WINDOW=128000

# Fraction of the context window to use for each chunk (0–1).
# The default 0.85 leaves ~15 % headroom for the prompt wrapper
# and the LLM's response.
# AI_CHUNK_RATIO=0.85

# BCP-47 language code for summary output.
# "vi" = Vietnamese, "en" = English, etc.
SUMMARY_OUTPUT_LANG=vi

# BCP-47 language code for research-direction output.
RESEARCH_OUTPUT_LANG=vi

# ============================================
# Upload Configuration
# ============================================
UPLOAD_DIR=./uploads
